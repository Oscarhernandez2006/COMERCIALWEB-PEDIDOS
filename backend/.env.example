# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=comercial
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=change_this_super_secret_in_production
JWT_EXPIRES_IN=1d

# SSO (inicio de sesión desde la suite SCTOOLS)
# URL base del backend de la suite. En dev suele ser http://localhost:8000
SSO_ISSUER_URL=http://localhost:8000
# Secreto compartido con la suite. Debe ser IDÉNTICO al SSO_SHARED_SECRET de SCTOOLS.
SSO_SHARED_SECRET=

# Siesa API
SIESA_BASE_URL=https://api.siesa.com
SIESA_CONNI_KEY=
SIESA_CONNI_TOKEN=
SIESA_USERNAME=
SIESA_PASSWORD=
SIESA_COMPANY_ID=
SIESA_TIMEOUT_MS=15000

# Despacho · Facturas TAT para Drivin
# Endpoints de Siesa por compañía (AGROPECUARIA=3, CARNES FRIAS=8). Se consultan
# con ?cia={compañía}&fecha_inicio&fecha_fin (y &token=... si aplica).
DISPATCH_TAT_INVOICES_URL=
DISPATCH_TAT_INVOICES_URL_CARNES=
DISPATCH_TAT_INVOICES_TOKEN=
DISPATCH_API_TOKEN=
DISPATCH_TIMEOUT_MS=30000
